# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Saídas de teste / trabalho local
/tmp/
*.log
.DS_Store

# Conteúdo gerado no vault NÃO pertence a este repo
# (o repo guarda as SKILLS, não o material produzido por elas)
vault/
out/
*.zip

# Versões antigas e pacotes de entrega (artefatos locais, não fonte)
old/
deploy-*/
# só na raiz: modelo coletado durante o trabalho. O exemplo versionado vive em
# skills/concurso-publica/examples/ e é fonte, não artefato local.
/site-model-*.json

# Instalação local das skills: .claude/skills e .claude/agents são CÓPIAS que o
# scripts/install.sh gera a partir de skills/. A fonte é skills/ — versionar as
# duas duplicaria tudo e abriria espaço para divergirem.
# O .claude/CLAUDE.md (integração com o vault) é fonte e continua versionado.
#
# O glob é `**/` e não `.claude/` porque um `install.sh --local` rodado de dentro de
# uma subpasta grava lá, não na raiz: já apareceu um deploy/.claude/ de 1,3 MB que o
# padrão ancorado na raiz não pegava — e o Claude Code passou a carregar as quatro
# skills duplicadas, com escopo `deploy:`, competindo com as originais.
**/.claude/skills/
**/.claude/agents/

# Config local de deploy (host, usuário, caminhos da máquina)
deploy/deploy.env

# Credencial do NotebookLM: são ~15 cookies do Google e dão acesso à CONTA INTEIRA,
# não só ao NotebookLM. Vivem fora do repo (em $NOTEBOOKLM_HOME, por padrão
# ~/.notebooklm), mas estas entradas existem para o caso de alguém apontar o
# NOTEBOOKLM_HOME para dentro do projeto — o erro é fácil e o estrago é grande.
.notebooklm*/
storage_state.json
*.storage_state.json
master_token.json

# Editores
.vscode/
.idea/
